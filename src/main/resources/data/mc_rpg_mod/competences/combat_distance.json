            { "type": "flag", "flag": "projectile_velocity", "multiplier": 1.25 },
            { "type": "flag", "flag": "projectile_gravity", "multiplier": 0.75 }
          ]
        },
        {
          "id": "empoisonneur", "name": "Empoisonneur",
          "description": "Les flèches de potion durent 50 % plus longtemps",
          "effects": [
            { "type": "flag", "flag": "tipped_arrow_duration", "multiplier": 1.5 }
          ]
        }
      ]
    },
    {
      "level": 50,
      "nodes": [
        {
          "id": "volee", "name": "Volée",
          "description": "Un tir en lance cinq en éventail",
          "trigger": {
            "family": "reflex", "on": "bow_release",
            "require": { "crouching": true }
          },
          "effects": [
            {
              "type": "ability", "action": "volley",
              "count": 5, "spread_degrees": 20, "consumes_arrows": 1,
              "cooldown_ticks": 600
            }
          ]
