    { "on": "ranged_hit", "xp": 3 },
    { "on": "kill", "filter": "#minecraft:monster", "require": { "ranged": true }, "xp": 14 },
    { "on": "ranged_hit", "require": { "distance_over": 30 }, "xp": 8 }
  ],
  "tiers": [
    {
      "level": 5,
      "nodes": [
        {
          "id": "visee", "name": "Visée",
          "description": "L'arc se bande 10 % plus vite",
          "effects": [
            { "type": "flag", "flag": "draw_speed", "multiplier": 1.1 }
          ]
        }
      ]
    },
    {
      "level": 10, "exclusive": true,
      "nodes": [
        {
          "id": "carquois", "name": "Carquois",
          "description": "10 % de chance de récupérer la flèche tirée",
          "effects": [
            { "type": "flag", "flag": "arrow_recovery", "chance": 0.1 }
          ]
        },
        {
          "id": "tireur_rapide", "name": "Tireur rapide",
          "description": "L'arbalète se recharge 25 % plus vite",
          "effects": [
            { "type": "flag", "flag": "crossbow_reload_speed", "multiplier": 1.25 }
          ]
        }
      ]
    },
    {
      "level": 20,
      "nodes": [
        {
          "id": "tir_vise", "name": "Tir visé",
          "description": "Au-delà d'1,5 s de visée, critique garanti qui traverse une cible",
          "trigger": {
            "family": "reflex", "on": "bow_release",
            "require": { "draw_ticks_at_least": 30 }
          },
          "effects": [
            {
              "type": "ability", "action": "aimed_shot",
              "guaranteed_crit": true, "pierce": 1, "cooldown_ticks": 0
            }
          ]
        }
      ]
    },
    {
      "level": 35, "exclusive": true,
      "nodes": [
        {
          "id": "balistique", "name": "Balistique",
