          "effects": [
            { "type": "ability", "action": "slide", "duration_ticks": 16, "cooldown_ticks": 30 },
            { "type": "flag", "flag": "slide_hitbox" }
          ]
        },
        {
          "id": "pas_de_l_air",
          "name": "Pas de l'air",
          "description": "Un court instant pour sauter après avoir quitté le bord",
