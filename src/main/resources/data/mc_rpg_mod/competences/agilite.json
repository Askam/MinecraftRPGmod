          "description": "Un second saut en l'air, rechargé au contact du sol",
          "trigger": {
            "family": "reflex",
            "on": "client_jump_airborne",
            "require": { "not_used_since_ground_contact": true }
          },
          "effects": [
            { "type": "ability", "action": "impulse", "vector": [0, 0.42, 0], "cooldown_ticks": 0 }
          ]
        }
      ]
    },

    {
      "level": 35,
      "exclusive": true,
      "nodes": [
        {
          "id": "glissade",
          "name": "Glissade",
