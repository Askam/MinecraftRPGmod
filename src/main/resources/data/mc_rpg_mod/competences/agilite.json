            "family": "reflex",
            "on": "fall",
            "require": { "crouch_pressed_within_ticks": 5 }
          },
          "effects": [
            { "type": "fall_distance", "subtract_blocks": 7 }
          ]
        },
        {
          "id": "grimpeur",
